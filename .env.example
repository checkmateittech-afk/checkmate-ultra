# Copy to .env for local development.

# SQLite (default for module 1 — zero infra):
DATABASE_URL="file:./dev.db"

# Postgres (Docker) — switch to this once `docker compose up -d` is running,
# and set datasource provider = "postgresql" in prisma/schema.prisma:
# DATABASE_URL="postgresql://checkmate:checkmate@localhost:5432/checkmate?schema=public"

# Auth (module 2) — dev secret; generate a strong one for any shared/prod env.
AUTH_SECRET="dev-only-insecure-secret-change-me-1234567890abcdef"
