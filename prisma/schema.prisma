// Checkmate Ultra — data model (module 1: public directory & search)
// SQLite for zero-infra local dev. Shape is Postgres-compatible:
// no scalar arrays, no native enums (status/role kept as String + app-level unions).
// To move to Postgres: set provider = "postgresql", update DATABASE_URL, run db:push + db:seed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id        String            @id @default(cuid())
  slug      String            @unique
  name      String
  icon      String            // lucide icon key, see src/lib/catalog.ts
  blurb     String
  sortOrder Int               @default(0)
  leadPrice Int               @default(20) // credits charged per delivered fan-out lead
  services  ProviderService[]
  createdAt DateTime          @default(now())
}

model City {
  id         String     @id @default(cuid())
  slug       String     @unique
  name       String
  state      String
  localities Locality[]
  providers  Provider[]
  createdAt  DateTime   @default(now())
}

model Locality {
  id        String     @id @default(cuid())
  slug      String
  name      String
  cityId    String
  city      City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  providers Provider[]

  @@unique([cityId, slug])
}

/// status: PENDING | ACTIVE | SUSPENDED | REJECTED
/// kycStatus: UNVERIFIED | SUBMITTED | VERIFIED | REJECTED
model Provider {
  id              String            @id @default(cuid())
  slug            String            @unique
  name            String
  about           String
  phone           String
  email           String?
  verified        Boolean           @default(false)
  status          String            @default("PENDING")
  kycStatus       String            @default("UNVERIFIED")
  tier            String            @default("FREE") // FREE | STARTER | PRO (mirrors Subscription)
  rankBoost       Int               @default(0) // search / distribution ranking bump from tier
  yearsInBusiness Int               @default(1)
  ratingAvg       Float             @default(0)
  ratingCount     Int               @default(0)
  addressLine     String
  ownerId         String?           @unique
  owner           User?             @relation(fields: [ownerId], references: [id])
  cityId          String
  city            City              @relation(fields: [cityId], references: [id])
  localityId      String
  locality        Locality          @relation(fields: [localityId], references: [id])
  services        ProviderService[]
  reviews         Review[]
  photos          ProviderPhoto[]
  leads           Lead[]
  kycSubmissions  KycSubmission[]
  wallet          Wallet?
  subscription    Subscription?
  createdAt       DateTime          @default(now())

  @@index([cityId])
  @@index([localityId])
  @@index([status])
}

model Wallet {
  id           String              @id @default(cuid())
  providerId   String              @unique
  provider     Provider            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  balance      Int                 @default(0) // credits
  lifetimeSpent Int                @default(0)
  transactions WalletTransaction[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

/// type: TOPUP | LEAD_CHARGE | REFUND | BONUS | PLAN_GRANT | ADJUSTMENT
/// amount is signed: positive = credit, negative = debit. Append-only ledger.
model WalletTransaction {
  id           String   @id @default(cuid())
  walletId     String
  wallet       Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type         String
  amount       Int
  balanceAfter Int
  refType      String?
  refId        String?
  note         String?
  createdAt    DateTime @default(now())

  @@index([walletId, createdAt])
}

model Plan {
  slug           String   @id
  name           String
  priceInr       Int
  monthlyCredits Int
  leadDiscountPct Int     @default(0)
  rankBoost      Int      @default(0)
  features       String   // newline-separated bullet points
  sortOrder      Int      @default(0)
}

model Subscription {
  id               String   @id @default(cuid())
  providerId       String   @unique
  provider         Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  planSlug         String
  status           String   @default("ACTIVE") // ACTIVE | CANCELLED
  currentPeriodEnd DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model KycSubmission {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  docType    String // PAN | GST | AADHAAR | UDYAM
  docRef     String // reference / masked number (no real doc upload yet)
  note       String?
  status     String   @default("SUBMITTED") // SUBMITTED | VERIFIED | REJECTED
  reviewedBy String?
  createdAt  DateTime @default(now())

  @@index([providerId])
  @@index([status])
}

/// One LeadRequest delivered to one provider. status: NEW | VIEWED | CONTACTED | WON | LOST
model Lead {
  id            String      @id @default(cuid())
  leadRequestId String
  leadRequest   LeadRequest @relation(fields: [leadRequestId], references: [id], onDelete: Cascade)
  providerId    String
  provider      Provider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  status        String      @default("NEW")
  note          String?
  creditCost    Int         @default(0)
  chargedAt     DateTime?
  viewedAt      DateTime?
  createdAt     DateTime    @default(now())

  @@unique([leadRequestId, providerId])
  @@index([providerId, status])
  @@index([providerId, createdAt])
}

model ProviderService {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  priceFrom  Int?
  priceUnit  String?  // "per visit", "per hour", "per sq ft", "per room"

  @@unique([providerId, categoryId])
  @@index([categoryId])
}

model ProviderPhoto {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  label      String
  tint       String   // hex seed for the CSS gradient tile
  sortOrder  Int      @default(0)
}

/// status: PUBLISHED | PENDING | HIDDEN
model Review {
  id                String    @id @default(cuid())
  providerId        String
  provider          Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?     @relation(fields: [userId], references: [id])
  authorName        String
  rating            Int
  title             String
  body              String
  status            String    @default("PUBLISHED")
  providerReply     String?
  providerRepliedAt DateTime?
  createdAt         DateTime  @default(now())

  @@index([providerId])
  @@index([status])
}

model LeadRequest {
  id           String   @id @default(cuid())
  name         String
  phone        String
  email        String?
  message      String
  categorySlug String?
  citySlug     String?
  providerId   String?
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  leads        Lead[]
  source       String   @default("web")
  status       String   @default("NEW")
  createdAt    DateTime @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

/// Roles: CONSUMER | PROVIDER_OWNER | PROVIDER_STAFF | MODERATOR | ADMIN
/// role: CONSUMER | PROVIDER_OWNER | PROVIDER_STAFF | EDITOR | MODERATOR | ADMIN
model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  email     String?  @unique
  role      String   @default("CONSUMER")
  status    String   @default("ACTIVE")
  lastLogin DateTime?
  createdAt DateTime @default(now())

  leads    LeadRequest[]
  provider Provider?
  reviews  Review[]
  courses  Course[]

  @@index([role])
}

model CourseCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  blurb     String?
  sortOrder Int      @default(0)
  courses   Course[]
  createdAt DateTime @default(now())
}

/// mode: ONLINE | CLASSROOM | HYBRID   status: DRAFT | PUBLISHED | ARCHIVED
model Course {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  subtitle        String?
  summary         String
  overview        String
  categoryId      String
  category        CourseCategory @relation(fields: [categoryId], references: [id])
  mode            String         @default("ONLINE")
  level           String?
  durationText    String?
  feeText         String?
  trainerName     String?
  highlights      String         @default("")
  curriculum      String         @default("")
  prerequisites   String?
  audience        String?
  faqJson         String         @default("[]")
  heroTint        String         @default("1f3a5f")
  status          String         @default("DRAFT")
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  authorId        String
  author          User           @relation(fields: [authorId], references: [id])
  publishedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([categoryId])
}

model OtpChallenge {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  purpose   String    @default("login")
  attempts  Int       @default(0)
  consumedAt DateTime?
  expiresAt DateTime
  ip        String?
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
}

/// Single row (id is always "singleton"). Platform-wide branding & controls, admin-editable.
model SiteSettings {
  id                 String   @id @default("singleton")
  siteName           String   @default("Checkmate")
  tagline            String?
  logoUrl            String?
  faviconUrl         String?
  supportEmail       String?
  supportPhone       String?
  primaryColor       String? // hex, no '#'; re-themes the brand accent site-wide
  announcementText   String?
  announcementActive Boolean  @default(false)
  updatedAt          DateTime @updatedAt
  updatedById        String?
}
